{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model3d-run/0.1",
  "title": "RunRecord",
  "description": "入力・設定・ツール版、実行順、生成物、検査値、人手の修正、採否と理由。問題を含む候補（candidates）と採用した結果（adopted）を分けて持つ。",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "finished_at",
    "status",
    "recipe",
    "inputs",
    "environment",
    "steps",
    "candidates",
    "adopted",
    "human_edits",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "model3d-run/0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "needs_review",
        "failed"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipe": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "name"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "preset": {
      "$ref": "#/$defs/fileref"
    },
    "semantic_map": {
      "$ref": "#/$defs/fileref"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "python",
        "platform",
        "numpy",
        "model3d"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "numpy": {
          "type": "string"
        },
        "model3d": {
          "type": "object",
          "required": [
            "version",
            "fingerprint"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "status",
          "key",
          "parameters",
          "inputs",
          "artifacts",
          "observations",
          "unresolved",
          "error",
          "reused_from"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "needs_review",
              "failed"
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "reused_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "select": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "space": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adopted": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected",
            "hold"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "human_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "by",
          "what"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "$defs": {
    "fileref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
