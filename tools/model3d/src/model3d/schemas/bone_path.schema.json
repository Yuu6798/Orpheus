{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model3d-bone-path/0.1",
  "title": "model3d bone path",
  "description": "motion.bone_path が測る、動きのコマ f ごとの骨の付け根の位置（bones）と、骨から決めた点の位置（points。顔・胸・手の先など）。世界の座標、m（シーンの scale_length を掛けてある）。bones と points の各列は frames と同じ順・同じ数。bones か points のどちらかに 1 つ以上の列がある。",
  "type": "object",
  "required": ["schema_version", "unit", "frames", "bones"],
  "properties": {
    "schema_version": {"const": "model3d-bone-path/0.1"},
    "unit": {"const": "m"},
    "scale_length": {"description": "1 Blender 単位が何 m か", "type": "number", "exclusiveMinimum": 0},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "armature": {"type": "string"},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "bones": {"$ref": "#/$defs/columns"},
    "points": {"description": "motion.bone_path の points で決めた点（名前 → 位置の列）", "$ref": "#/$defs/columns"},
    "notes": {"type": "string"}
  },
  "anyOf": [
    {"properties": {"bones": {"minProperties": 1}}},
    {"required": ["points"], "properties": {"points": {"minProperties": 1}}}
  ],
  "patternProperties": {"^x_": {}},
  "additionalProperties": false,
  "$defs": {
    "columns": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "array",
        "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
      }
    }
  }
}
