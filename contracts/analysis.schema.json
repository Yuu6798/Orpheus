{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "v0.1 proposal. Cross-file and time consistency require semantic validation described in docs/design.md.",
  "title": "MV analysis v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_start_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "source_sha256",
        "sample_rate",
        "sample_count",
        "duration_s",
        "source_start_s"
      ]
    },
    "bpm": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "beats_s": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "model",
              "manual"
            ]
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "confirmed",
              "needs_fix"
            ]
          }
        },
        "required": [
          "id",
          "start_s",
          "end_s",
          "label",
          "source",
          "review_status"
        ]
      }
    },
    "lyrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "alignment_text": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "end_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "timing_source": {
            "enum": [
              "model",
              "interpolated",
              "manual",
              "unknown"
            ]
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "confirmed",
              "needs_fix"
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "text",
          "alignment_text",
          "start_s",
          "end_s",
          "timing_source",
          "review_status",
          "confidence"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "timing_source": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "start_s": {
                  "type": "null"
                },
                "end_s": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "timing_source": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "review_status": {
                  "enum": [
                    "unreviewed",
                    "needs_fix"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "stage",
          "tool",
          "version",
          "model"
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "target_id",
          "message"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "analysis_id",
    "audio",
    "bpm",
    "beats_s",
    "sections",
    "lyrics",
    "provenance",
    "issues"
  ]
}
