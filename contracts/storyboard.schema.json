{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "v0.1 proposal. Cross-file and time consistency require semantic validation described in docs/design.md.",
  "title": "MV storyboard v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "storyboard_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        },
        "show_lyrics": {
          "type": "boolean"
        }
      },
      "required": [
        "fps",
        "width",
        "height",
        "duration_frames",
        "show_lyrics"
      ]
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reference_asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "description",
        "reference_asset_id"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "lyric_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "prompt": {
            "type": "string"
          },
          "motion": {
            "enum": [
              "still",
              "slow_push",
              "pan_left",
              "pan_right"
            ]
          },
          "transition_in": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "crossfade"
                ]
              },
              "duration_frames": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "duration_frames"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "cut"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "duration_frames": {
                      "const": 0
                    }
                  }
                },
                "else": {
                  "properties": {
                    "duration_frames": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            ]
          },
          "intent": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "start_frame",
          "end_frame",
          "lyric_ids",
          "asset_id",
          "prompt",
          "motion",
          "transition_in",
          "intent"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "storyboard_id",
    "analysis_id",
    "analysis_sha256",
    "audio_sha256",
    "render",
    "world",
    "scenes"
  ]
}
