{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dance-shot/0.1",
  "type": "object",
  "required": ["schema_version", "output", "duration_s", "stage", "performer"],
  "additionalProperties": false,
  "patternProperties": {"^x_": {}},
  "properties": {
    "schema_version": {"const": "dance-shot/0.1"},
    "output": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {
        "width": {"type": "integer", "minimum": 16},
        "height": {"type": "integer", "minimum": 16},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "crf": {"type": "integer", "minimum": 0, "maximum": 51}
      }
    },
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "audio": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {"path": {"type": "string"}, "offset_s": {"type": "number"}}
    },
    "stage": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {"path": {"type": "string"}}
    },
    "performer": {
      "type": "object",
      "required": ["clips"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "start", "end"],
            "additionalProperties": false,
            "patternProperties": {"^x_": {}},
            "properties": {
              "path": {"type": "string"},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "source_start": {"type": "number", "minimum": 0},
              "speed": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {"^x_": {}},
          "properties": {
            "color": {"$ref": "#/$defs/rgb"},
            "tolerance": {"type": "number", "minimum": 0, "maximum": 2},
            "softness": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
            "spill": {"type": "number", "minimum": 0, "maximum": 1},
            "choke_px": {"type": "number", "minimum": 0},
            "feather_px": {"type": "number", "minimum": 0}
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {"^x_": {}},
          "properties": {
            "anchor": {"$ref": "#/$defs/point"},
            "pivot": {"$ref": "#/$defs/point"},
            "height": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["t"],
            "additionalProperties": false,
            "patternProperties": {"^x_": {}},
            "properties": {
              "t": {"type": "number", "minimum": 0},
              "zoom": {"type": "number", "exclusiveMinimum": 0},
              "center": {"$ref": "#/$defs/point"},
              "rotate_deg": {"type": "number"},
              "ease": {"enum": ["linear", "in", "out", "in_out"]}
            }
          }
        },
        "seams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t"],
            "additionalProperties": false,
            "patternProperties": {"^x_": {}},
            "properties": {
              "t": {"type": "number", "minimum": 0},
              "span_s": {"type": "number", "exclusiveMinimum": 0},
              "zoom": {"type": "number", "exclusiveMinimum": 0},
              "rotate_deg": {"type": "number"}
            }
          }
        }
      }
    },
    "flashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t"],
        "additionalProperties": false,
        "patternProperties": {"^x_": {}},
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "strength": {"type": "number", "minimum": 0, "maximum": 1},
          "decay_s": {"type": "number", "exclusiveMinimum": 0},
          "color": {"$ref": "#/$defs/rgb"}
        }
      }
    },
    "lyrics": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {
        "font": {"type": "string"},
        "font_index": {"type": "integer", "minimum": 0},
        "ui_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "box"],
            "additionalProperties": false,
            "properties": {"name": {"type": "string"}, "box": {"$ref": "#/$defs/box"}}
          }
        },
        "back": {"$ref": "#/$defs/lyric_layer"},
        "band": {"$ref": "#/$defs/lyric_layer"},
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["layer", "text", "start", "end"],
            "additionalProperties": false,
            "patternProperties": {"^x_": {}},
            "properties": {
              "layer": {"enum": ["back", "band"]},
              "text": {"type": "string", "minLength": 1},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "words": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["text"],
                  "additionalProperties": false,
                  "properties": {
                    "text": {"type": "string", "minLength": 1},
                    "t": {"type": "number", "minimum": 0},
                    "accent": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rgb": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 255}, {"type": "number", "minimum": 0, "maximum": 255}, {"type": "number", "minimum": 0, "maximum": 255}], "minItems": 3, "maxItems": 3},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "box": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
    "lyric_layer": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x_": {}},
      "properties": {
        "box": {"$ref": "#/$defs/box"},
        "size_px": {"type": "number", "exclusiveMinimum": 0},
        "color": {"$ref": "#/$defs/rgb"},
        "accent_color": {"$ref": "#/$defs/rgb"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "stroke_px": {"type": "number", "minimum": 0},
        "stroke_color": {"$ref": "#/$defs/rgb"},
        "fade_in_s": {"type": "number", "minimum": 0},
        "fade_out_s": {"type": "number", "minimum": 0}
      }
    }
  }
}
