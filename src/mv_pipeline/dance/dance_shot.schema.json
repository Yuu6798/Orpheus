{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dance-shot/0.2",
  "type": "object",
  "required": [
    "schema_version",
    "output",
    "duration_s",
    "stage",
    "performer"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "schema_version": {
      "const": "dance-shot/0.2"
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        }
      }
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "beats": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bpm"
          ],
          "additionalProperties": false,
          "properties": {
            "bpm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offset_s": {
              "type": "number"
            },
            "beats_per_bar": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 2
            },
            "downbeat_phase": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "path": {
          "type": "string"
        },
        "offset_s": {
          "type": "number"
        },
        "fit": {
          "enum": [
            "strict",
            "pad"
          ]
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "path": {
          "type": "string"
        },
        "source_start": {
          "type": "number"
        },
        "loop": {
          "type": "boolean"
        },
        "parallax": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "performer": {
      "type": "object",
      "required": [
        "clips"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "clips": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x_": {}
            },
            "properties": {
              "path": {
                "type": "string"
              },
              "start": {
                "$ref": "#/$defs/time"
              },
              "end": {
                "$ref": "#/$defs/time"
              },
              "source_start": {
                "type": "number"
              },
              "speed": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "placement": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^x_": {}
                },
                "properties": {
                  "offset": {
                    "$ref": "#/$defs/point"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "flip_x": {
                    "type": "boolean"
                  }
                }
              },
              "fit": {
                "const": false
              },
              "transition_in": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "const": "cut"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "frames"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "const": "blend"
                      },
                      "frames": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              },
              "beat_exempt": {
                "type": "boolean"
              }
            }
          }
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "color": {
              "$ref": "#/$defs/rgb"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "softness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 2
            },
            "spill": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "choke_px": {
              "type": "number",
              "minimum": 0
            },
            "feather_px": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "anchor": {
              "$ref": "#/$defs/point"
            },
            "pivot": {
              "$ref": "#/$defs/point"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "flip_x": {
              "type": "boolean"
            }
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "mode": {
              "enum": [
                "frame",
                "body"
              ]
            },
            "body_height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "x": {
              "enum": [
                "median",
                "track",
                "none"
              ]
            },
            "x_smooth_s": {
              "type": "number",
              "minimum": 0
            },
            "ground": {
              "enum": [
                "lock",
                "median",
                "none"
              ]
            },
            "ground_window_s": {
              "type": "number",
              "minimum": 0
            },
            "ground_smooth_s": {
              "type": "number",
              "minimum": 0
            },
            "analysis_scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "t"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x_": {}
            },
            "properties": {
              "t": {
                "$ref": "#/$defs/time"
              },
              "zoom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "center": {
                "$ref": "#/$defs/point"
              },
              "rotate_deg": {
                "type": "number"
              },
              "ease": {
                "enum": [
                  "linear",
                  "in",
                  "out",
                  "in_out"
                ]
              }
            }
          }
        },
        "seams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x_": {}
            },
            "properties": {
              "t": {
                "$ref": "#/$defs/time"
              },
              "span_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "zoom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rotate_deg": {
                "type": "number"
              },
              "pre_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "post_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rotate_post_deg": {
                "type": "number"
              },
              "pivot": {
                "$ref": "#/$defs/point"
              },
              "blur": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^x_": {}
                },
                "properties": {
                  "samples": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 64
                  },
                  "shutter_frames": {
                    "type": "number",
                    "minimum": 0
                  },
                  "peak_shutter_frames": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "cover_rotation": {
          "type": "boolean"
        },
        "accents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x_": {}
            },
            "properties": {
              "at": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/time"
                    }
                  },
                  {
                    "$ref": "#/$defs/time_grid"
                  }
                ]
              },
              "zoom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "attack_s": {
                "type": "number",
                "minimum": 0
              },
              "decay_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shake_px": {
                "type": "number",
                "minimum": 0
              },
              "shake_decay_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shake_hz": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "flashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {}
        },
        "properties": {
          "t": {
            "$ref": "#/$defs/time"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decay_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "$ref": "#/$defs/rgb"
          },
          "mode": {
            "enum": [
              "lerp_linear",
              "add_display"
            ]
          },
          "beat_exempt": {
            "type": "boolean"
          }
        }
      }
    },
    "lyrics": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "font": {
          "type": "string"
        },
        "font_index": {
          "type": "integer",
          "minimum": 0
        },
        "ui_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "box"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "box": {
                "$ref": "#/$defs/box"
              }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "layer",
              "text",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x_": {}
            },
            "properties": {
              "layer": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "$ref": "#/$defs/time"
              },
              "end": {
                "$ref": "#/$defs/time"
              },
              "words": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "t": {
                      "$ref": "#/$defs/time"
                    },
                    "accent": {
                      "type": "boolean"
                    },
                    "color": {
                      "$ref": "#/$defs/rgb"
                    },
                    "row": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "style": {
                "$ref": "#/$defs/lyric_style"
              },
              "sung": {
                "type": "boolean"
              }
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "layers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/lyric_layer"
          }
        }
      }
    }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "box": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "time": {
      "description": "秒の数値か拍の参照。読み込み時に秒へ解決する",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "beat"
          ],
          "additionalProperties": false,
          "properties": {
            "beat": {
              "type": "number"
            },
            "offset_s": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bar"
          ],
          "additionalProperties": false,
          "properties": {
            "bar": {
              "type": "number"
            },
            "beat": {
              "type": "number"
            },
            "offset_s": {
              "type": "number"
            }
          }
        }
      ]
    },
    "time_grid": {
      "type": "object",
      "required": [
        "grid"
      ],
      "additionalProperties": false,
      "properties": {
        "grid": {
          "enum": [
            "beats",
            "downbeats"
          ]
        },
        "from": {
          "$ref": "#/$defs/time"
        },
        "to": {
          "$ref": "#/$defs/time"
        },
        "every": {
          "type": "integer",
          "minimum": 1
        },
        "except": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time"
          }
        },
        "except_tolerance_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lyric_style": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "box": {
          "$ref": "#/$defs/box"
        },
        "size_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "$ref": "#/$defs/rgb"
        },
        "accent_color": {
          "$ref": "#/$defs/rgb"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stroke_px": {
          "type": "number",
          "minimum": 0
        },
        "stroke_color": {
          "$ref": "#/$defs/rgb"
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        },
        "font": {
          "type": "string"
        },
        "rows": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "align": {
              "enum": [
                "center",
                "left",
                "right",
                "stagger"
              ]
            },
            "gap_em": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "reveal": {
          "enum": [
            "line",
            "word"
          ]
        },
        "enter": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "scale_from": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rise_px": {
              "type": "number"
            },
            "dur_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "scale_to": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dur_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "glow": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "color": {
              "$ref": "#/$defs/rgb"
            },
            "radius_px": {
              "type": "number",
              "minimum": 0
            },
            "strength": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "follow_camera": {
          "type": "boolean"
        },
        "exclusive": {
          "type": "boolean"
        },
        "sung": {
          "type": "boolean"
        }
      }
    },
    "lyric_layer": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "box": {
          "$ref": "#/$defs/box"
        },
        "size_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "$ref": "#/$defs/rgb"
        },
        "accent_color": {
          "$ref": "#/$defs/rgb"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stroke_px": {
          "type": "number",
          "minimum": 0
        },
        "stroke_color": {
          "$ref": "#/$defs/rgb"
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        },
        "font": {
          "type": "string"
        },
        "rows": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "align": {
              "enum": [
                "center",
                "left",
                "right",
                "stagger"
              ]
            },
            "gap_em": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "reveal": {
          "enum": [
            "line",
            "word"
          ]
        },
        "enter": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "scale_from": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rise_px": {
              "type": "number"
            },
            "dur_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "scale_to": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dur_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "glow": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "color": {
              "$ref": "#/$defs/rgb"
            },
            "radius_px": {
              "type": "number",
              "minimum": 0
            },
            "strength": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "follow_camera": {
          "type": "boolean"
        },
        "exclusive": {
          "type": "boolean"
        },
        "sung": {
          "type": "boolean"
        },
        "z": {
          "enum": [
            "behind",
            "front"
          ]
        }
      }
    }
  }
}
