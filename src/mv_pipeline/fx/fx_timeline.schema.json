{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fx-timeline/0.2",
  "description": "複数のショットを時刻順に並べ、つなぎ（cut・xfade・black・flash・burn）で 1 本にする。0.2 は 0.1 につなぎの焼け抜け（burn）を足した版で、0.1 の timeline（fx_timeline_0_1.schema.json）もそのまま読める（絵は同じ）。ショットは fx-shot の spec（spec）か動画（video）。ショットは次のショットの start（最後は duration_s）まで。look（fx-shot と同じ定義。読み込み時に足す）はつないだ後の全体に掛ける。",
  "type": "object",
  "required": [
    "schema_version",
    "output",
    "duration_s",
    "shots"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "schema_version": {
      "const": "fx-timeline/0.2"
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        }
      }
    },
    "duration_s": {
      "description": "全体の長さ（秒）。最後のショットの終わり",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "beats": {
      "description": "拍の格子（dance-shot と同じ書き方）。時刻の拍の参照と snap に使う",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bpm"
          ],
          "additionalProperties": false,
          "properties": {
            "bpm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offset_s": {
              "type": "number"
            },
            "beats_per_bar": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 2
            },
            "downbeat_phase": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "path": {
          "type": "string"
        },
        "offset_s": {
          "type": "number",
          "description": "timeline の 0 秒に当てる音声の中の秒"
        }
      }
    },
    "pulse": {
      "description": "拍の脈: 拍ごとに全部のショットの camera の zoom に (1 + amount·exp(−(t − 直前の拍)·decay)) を掛ける（実制作のレンダラの beat_pulse。beats が要る）",
      "type": "object",
      "required": [
        "amount"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "description": "拍の瞬間に zoom に足す割合（実制作は Shorts 0.006・本編 0.010）"
        },
        "decay": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "減り方（1/秒。既定 9）"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "description": "脈を掛ける区間 [始め, 終わり)（timeline の秒か拍の参照）。無ければ全体",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/time"
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "start"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {}
        },
        "properties": {
          "spec": {
            "description": "fx-shot の spec（このファイルからの相対パス）。出力の大きさで描く。video とどちらか一方",
            "type": "string"
          },
          "video": {
            "$ref": "#/$defs/video"
          },
          "camera": {
            "$ref": "#/$defs/video_camera"
          },
          "faces": {
            "description": "動画のショットの顔の枠（動画の正規化座標）。spec のショットは spec の faces を使う。run がカメラで画面へ写して faces.json に書く",
            "type": "array",
            "items": {
              "$ref": "#/$defs/face"
            }
          },
          "start": {
            "$ref": "#/$defs/time"
          },
          "snap": {
            "description": "start をいちばん近い拍に寄せる（beats が要る。0 以下は 0、終わりの 0.01 秒以内は終わり）",
            "type": "boolean"
          },
          "offset_s": {
            "description": "spec のショットの頭に当てる、spec の中の時刻（秒。既定 0）。video のショットでは video.offset_s を使う",
            "type": "number",
            "minimum": 0
          },
          "variant": {
            "enum": [
              "base",
              "layers",
              "light",
              "both"
            ],
            "description": "spec のショットを描く fx の版（既定 both）"
          },
          "transition_in": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "cut"
                  }
                }
              },
              {
                "type": "object",
                "description": "前のショットを描き続け、start から duration_s の間 smoothstep で重ねる",
                "required": [
                  "type",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "xfade"
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "description": "start から duration_s の間、黒から smoothstep で上げる",
                "required": [
                  "type",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "black"
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "description": "start から window_s の間、色へ strength·exp(−経過·rate) だけ寄せる",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "flash"
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "color": {
                    "$ref": "#/$defs/rgb"
                  },
                  "window_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "description": "焼け抜け（0.2）。前のショットを描き続け、start から duration_s の間、ノイズの形に焼け抜けて今のショットが現れる。進み p = (t − start)/duration_s。場 N（画面の正規化座標の上のノイズ、0..1）としきい値 thr = −(soft + 縁の width) + p·(1 + 2·(soft + 縁の width)) で、今のショットの割合は clamp((thr − N)/soft, 0, 1)",
                "required": [
                  "type",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "burn"
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295,
                    "description": "ノイズの模様の seed（既定 0）。模様は seed と scale と画面の縦横比で決まり、時刻では変わらない"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 4,
                    "description": "模様の大きさ（画面の幅に対する割合。既定 0.08）。粗いむらの升目 4 つ分で、細かいむらの升目はその 1/16"
                  },
                  "soft": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1,
                    "description": "焼け抜けの境目のやわらかさ（場の値の幅。既定 0.035）"
                  },
                  "edge": {
                    "description": "光る縁。e = clamp(1 − |N − thr|/width, 0, 1) を color × gain でスクリーン合成する。無いか gain 0 なら縁なし。color の既定は (255, 125, 35)",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "color": {
                        "$ref": "#/$defs/rgb"
                      },
                      "width": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1,
                        "description": "縁の幅（場の値の幅。既定 0.05）"
                      },
                      "gain": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 4,
                        "description": "縁の強さ（既定 0.9。color × gain × e は 255 で止める）"
                      }
                    }
                  },
                  "char": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "焦げ。前線の少し先（まだ前のショットの側）の帯を、この割合まで暗くする（既定 0 = 無効）"
                  },
                  "from": {
                    "description": "広がり始める点（画面の正規化座標 [x, y]。既定 [0.5, 0.5]）。bias > 0 のときだけ使う",
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "bias": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "from からの距離を場に混ぜる割合（N·(1 − bias) + 距離·bias。既定 0 = ノイズだけ。1 で from から丸く広がる）"
                  }
                }
              }
            ]
          },
          "beat_exempt": {
            "type": "boolean",
            "description": "mv gate の拍の照合で、この切れ目を対象外（意図）として数える"
          },
          "align": {
            "enum": [
              "beat",
              "downbeat"
            ],
            "description": "mv gate がこの切れ目を照合する先（既定 beat）"
          }
        },
        "oneOf": [
          {
            "required": [
              "spec"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "video"
                  ]
                },
                {
                  "required": [
                    "camera"
                  ]
                },
                {
                  "required": [
                    "faces"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "video"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "spec"
                  ]
                },
                {
                  "required": [
                    "offset_s"
                  ]
                },
                {
                  "required": [
                    "variant"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "time": {
      "description": "秒の数値か、拍の参照か、出力のコマ番号（{\"frame\": n} は n / output.fps 秒）",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "frame"
          ],
          "additionalProperties": false,
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "beat"
          ],
          "additionalProperties": false,
          "properties": {
            "beat": {
              "type": "number"
            },
            "offset_s": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bar"
          ],
          "additionalProperties": false,
          "properties": {
            "bar": {
              "type": "number"
            },
            "beat": {
              "type": "number"
            },
            "offset_s": {
              "type": "number"
            }
          }
        }
      ]
    },
    "rgb": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "video": {
      "description": "動画のショットの素材。コマ位置は (offset_s + ショットの中の時刻·speed)·fps（loop があればループの式）。小数の位置は前後のコマを混ぜ、端のコマで止まる",
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "path": {
          "type": "string",
          "description": "動画（このファイルからの相対パス）"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "コマ位置の計算に使う動画の fps（既定はファイルの fps）"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "再生の速さ（既定 1）。loop ではループの速さ"
        },
        "offset_s": {
          "type": "number",
          "minimum": 0,
          "description": "ショットの頭に当てる動画の中の秒（既定 0）。loop とは一緒に使えない"
        },
        "loop": {
          "description": "コマ frames[0]〜frames[1] を繰り返す。つなぎ目は crossfade_frames コマ重ねる。mix > 0 なら速さと位相をずらしたもう 1 本を重みで重ねる",
          "type": "object",
          "required": [
            "frames"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "frames": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "crossfade_frames": {
              "type": "number",
              "minimum": 0,
              "description": "つなぎ目で重ねるコマ数（既定 6。区間の半分まで。それより長いと重ねが終わる前に折り返す）"
            },
            "start_s": {
              "type": "number",
              "description": "ショットの中の時刻に足す秒（ループの中の位置。speed が掛かる前。既定 0）"
            },
            "mix": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "もう 1 本の重み（既定 0 = 重ねない）"
            },
            "mix_speed": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "もう 1 本の時刻の倍率（既定 0.77）"
            },
            "mix_offset_s": {
              "type": "number",
              "description": "もう 1 本の時刻に足す秒（既定 0.41）"
            }
          }
        }
      }
    },
    "video_camera": {
      "description": "動画のショットのカメラ。keys は fx-shot の camera.keys と同じ書き方（t はショットの中の秒、center は動画の正規化座標）。frame・clamp・punch も fx-shot の camera と同じ。既定は寄りなし・中央・cover",
      "type": "object",
      "required": [
        "keys"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/video_camera_key"
          }
        },
        "frame": {
          "enum": [
            "cover",
            "source"
          ],
          "description": "視野をどこから取るか（fx-shot の camera.frame と同じ。source は動画の全体）"
        },
        "clamp": {
          "type": "boolean",
          "description": "視野を動画の中に止める（fx-shot の camera.clamp と同じ）"
        },
        "punch": {
          "type": "object",
          "required": [
            "amount",
            "duration_s"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.9
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "入りの押し込み（fx-shot の camera.punch と同じ）"
        }
      }
    },
    "video_camera_key": {
      "type": "object",
      "required": [
        "t"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0
        },
        "zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "ease": {
          "enum": [
            "linear",
            "in",
            "out",
            "in_out"
          ]
        }
      }
    },
    "face": {
      "type": "object",
      "required": [
        "box"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "box": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "role": {
          "enum": [
            "main",
            "other"
          ]
        },
        "estimated": {
          "type": "boolean"
        }
      }
    }
  }
}
