{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fx-timeline/0.1",
  "description": "複数の fx ショット（fx-shot の spec）を時刻順に並べ、つなぎ（cut・xfade・black・flash）で 1 本にする。ショットは次のショットの start（最後は duration_s）まで。look（fx-shot と同じ定義。読み込み時に足す）はつないだ後の全体に掛ける。",
  "type": "object",
  "required": [
    "schema_version",
    "output",
    "duration_s",
    "shots"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "schema_version": {
      "const": "fx-timeline/0.1"
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        }
      }
    },
    "duration_s": {
      "description": "全体の長さ（秒）。最後のショットの終わり",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "beats": {
      "description": "拍の格子（dance-shot と同じ書き方）。時刻の拍の参照と snap に使う",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bpm"
          ],
          "additionalProperties": false,
          "properties": {
            "bpm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "offset_s": {
              "type": "number"
            },
            "beats_per_bar": {
              "type": "integer",
              "minimum": 1
            },
            "count": {
              "type": "integer",
              "minimum": 2
            },
            "downbeat_phase": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "audio": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "path": {
          "type": "string"
        },
        "offset_s": {
          "type": "number",
          "description": "timeline の 0 秒に当てる音声の中の秒"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spec",
          "start"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x_": {}
        },
        "properties": {
          "spec": {
            "description": "fx-shot の spec（このファイルからの相対パス）。出力の大きさで描く",
            "type": "string"
          },
          "start": {
            "$ref": "#/$defs/time"
          },
          "snap": {
            "description": "start をいちばん近い拍に寄せる（beats が要る。0 以下は 0、終わりの 0.01 秒以内は終わり）",
            "type": "boolean"
          },
          "offset_s": {
            "description": "このショットの頭に当てる、ショットの spec の中の時刻（秒。既定 0）",
            "type": "number",
            "minimum": 0
          },
          "variant": {
            "enum": [
              "base",
              "layers",
              "light",
              "both"
            ],
            "description": "ショットを描く fx の版（既定 both）"
          },
          "transition_in": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "cut"
                  }
                }
              },
              {
                "type": "object",
                "description": "前のショットを描き続け、start から duration_s の間 smoothstep で重ねる",
                "required": [
                  "type",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "xfade"
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "description": "start から duration_s の間、黒から smoothstep で上げる",
                "required": [
                  "type",
                  "duration_s"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "black"
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "description": "start から window_s の間、色へ strength·exp(−経過·rate) だけ寄せる",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "flash"
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "color": {
                    "$ref": "#/$defs/rgb"
                  },
                  "window_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            ]
          },
          "beat_exempt": {
            "type": "boolean",
            "description": "mv gate の拍の照合で、この切れ目を対象外（意図）として数える"
          },
          "align": {
            "enum": [
              "beat",
              "downbeat"
            ],
            "description": "mv gate がこの切れ目を照合する先（既定 beat）"
          }
        }
      }
    }
  },
  "$defs": {
    "time": {
      "description": "秒の数値か、拍の参照か、出力のコマ番号（{\"frame\": n} は n / output.fps 秒）",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "required": [
            "frame"
          ],
          "additionalProperties": false,
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "beat"
          ],
          "additionalProperties": false,
          "properties": {
            "beat": {
              "type": "number"
            },
            "offset_s": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bar"
          ],
          "additionalProperties": false,
          "properties": {
            "bar": {
              "type": "number"
            },
            "beat": {
              "type": "number"
            },
            "offset_s": {
              "type": "number"
            }
          }
        }
      ]
    },
    "rgb": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
