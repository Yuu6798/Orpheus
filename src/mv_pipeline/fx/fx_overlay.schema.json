{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fx-overlay",
  "description": "mv overlay が run の manifest.json の overlay の欄に残す、入力と設定の記録（fx-overlay/0.1。contracts/ の外）。土台・各レイヤー（連番は各コマの sha256）・音声の sha256 と、書き出しの設定。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base", "layers", "audio", "settings"],
  "properties": {
    "schema_version": {"const": "fx-overlay/0.1"},
    "base": {
      "type": "object",
      "required": ["kind", "path", "sha256", "size", "fps", "frames"],
      "properties": {
        "kind": {"enum": ["image", "video"]},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"$ref": "#/$defs/size"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frames": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "size", "frames"],
        "properties": {
          "kind": {"enum": ["frames", "video"]},
          "path": {"type": "string"},
          "size": {"$ref": "#/$defs/size"},
          "frames": {"type": "integer", "minimum": 1},
          "fps": {"type": ["number", "null"]},
          "sha256": {"$ref": "#/$defs/sha256"},
          "files": {
            "type": "array",
            "items": {"type": "object", "required": ["name", "sha256"],
                      "properties": {"name": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}
          }
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "frames"}}}, "then": {"required": ["files"]}},
          {"if": {"properties": {"kind": {"const": "video"}}}, "then": {"required": ["sha256"]}}
        ]
      }
    },
    "audio": {
      "type": ["object", "null"],
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "settings": {
      "type": "object",
      "required": ["fps", "crf", "size", "frames", "alpha", "blend"],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "crf": {"type": "integer", "minimum": 0, "maximum": 51},
        "size": {"$ref": "#/$defs/size"},
        "frames": {"type": "integer", "minimum": 1},
        "alpha": {"const": "straight"},
        "blend": {"const": "srgb"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2}
  }
}
