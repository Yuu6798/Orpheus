{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fx-overlay-layers/0.1",
  "description": "`mv overlay --layers` に渡すレイヤーの設定（実験的。contracts/ の外）。下から順に重ねる。path は連番のフォルダかアルファつきの動画、image は時刻を決めて重ねる 1 枚の画像（題字のカードなど）。style（色づけ・影・光彩・後光）は表示用の値（sRGB の 0..255）の上で、後光 → 影 → 光彩 → 本体の順に掛ける（実制作の重ねの式と同じ）。長さ（sigma_px など）は出力の短い辺を 1080 としたときの画素（1920x1080 でも 1080x1920 でもそのままの画素）。素材パスは設定ファイルのあるディレクトリ基準。`x_` で始まる鍵はどの階層でも許す。",
  "type": "object",
  "required": ["schema_version", "layers"],
  "properties": {
    "schema_version": {"const": "fx-overlay-layers/0.1"},
    "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}}
  },
  "additionalProperties": false,
  "patternProperties": {"^x_": {}},
  "$defs": {
    "path": {"type": "string", "minLength": 1},
    "color": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 255},
        {"type": "number", "minimum": 0, "maximum": 255},
        {"type": "number", "minimum": 0, "maximum": 255}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "layer": {
      "type": "object",
      "properties": {
        "path": {"$ref": "#/$defs/path", "description": "PNG などの連番のフォルダか、アルファつきの動画。"},
        "image": {"$ref": "#/$defs/path", "description": "1 枚の透過画像（start_s から end_s まで重ねる）。"},
        "first_frame": {"type": "integer", "minimum": 0, "description": "出力の 0 コマ目に当たる、連番のコマ番号（ファイル名の最後の数字）か動画のコマ番号。曲全体の番号で書いた連番から区間を取り出すときに使う。省けば連番は並びの順で、コマ数が出力と同じであること。"},
        "missing": {"enum": ["error", "transparent"], "default": "error", "description": "first_frame のとき、無いコマ（ファイルが無い・動画が終わった）を止めるか、透明として飛ばすか。"},
        "alpha": {"enum": ["straight", "premultiplied"], "default": "straight", "description": "premultiplied は色にアルファが掛かったもの（読むときに straight に直す）。"},
        "resize": {"type": "boolean", "default": false, "description": "大きさが土台と違うときに縮尺する（縦横比は 1% 以内）。省けば違いはエラー。"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 1},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "fade_in_s": {"type": "number", "minimum": 0, "default": 0},
        "fade_out_s": {"type": "number", "minimum": 0, "default": 0},
        "style": {"$ref": "#/$defs/style"}
      },
      "oneOf": [{"required": ["path"]}, {"required": ["image", "start_s", "end_s"]}],
      "additionalProperties": false,
      "patternProperties": {"^x_": {}}
    },
    "style": {
      "type": "object",
      "properties": {
        "tint": {"$ref": "#/$defs/color", "description": "本体の色 = tint × 輝度（白い単色の字に色をつける）。省けばレイヤー自身の色。"},
        "shadow": {
          "type": "object",
          "properties": {
            "amount": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.45},
            "sigma_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 400, "default": 4},
            "gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 20, "default": 1.5}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_": {}}
        },
        "glow": {
          "type": "object",
          "required": ["color"],
          "properties": {
            "color": {"$ref": "#/$defs/color"},
            "amount": {"type": "number", "minimum": 0, "maximum": 20, "default": 0.9},
            "sigma_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 400, "default": 14}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_": {}}
        },
        "backdrop": {
          "type": "object",
          "properties": {
            "amount": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.55},
            "dilate_px": {"type": "integer", "minimum": 1, "maximum": 99, "default": 5},
            "iterations": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
            "sigma_px": {"type": "number", "exclusiveMinimum": 0, "maximum": 400, "default": 26},
            "gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 20, "default": 1.6}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_": {}}
        }
      },
      "additionalProperties": false,
      "patternProperties": {"^x_": {}}
    }
  }
}
